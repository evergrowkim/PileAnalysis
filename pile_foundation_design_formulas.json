  "group_pile_effect": {
    "description": "무리말뚝 효율",

    "efficiency_formulas": {
      "converse_labarre": {
        "formula": "η = 1 - θ * ((n-1)*m + (m-1)*n) / (90*m*n)",
        "latex": "\\eta = 1 - \\frac{\\theta[(n-1)m + (m-1)n]}{90mn}",
        "variables": {
          "η": {
            "name": "무리말뚝 효율",
            "range": [0, 1]
          },
          "θ": {
            "name": "각도",
            "formula": "arctan(D/s)",
            "unit": "degree"
          },
          "m": {
            "name": "열 수"
          },
          "n": {
            "name": "행 수"
          },
          "D": {
            "name": "말뚝 직경",
            "unit": "m"
          },
          "s": {
            "name": "말뚝 중심간격",
            "unit": "m"
          }
        }
      },
      "feld_rule": {
        "description": "각 말뚝의 지지력은 인접 말뚝 1본당 1/16씩 감소",
        "formula": "η_pile = 1 - (adjacent_piles / 16)"
      }
    },

    "spacing_requirements": {
      "end_bearing_sandy": {
        "minimum": "2.5D",
        "recommended": "3.0D"
      },
      "friction_clayey": {
        "minimum": "3.0D",
        "recommended": "3.5D ~ 4.0D"
      },
      "cast_in_place": {
        "minimum": "2.0D",
        "recommended": "2.5D ~ 3.0D"
      },
      "no_group_effect_threshold": "8.0D",
      "note": "간격이 8D 이상이면 η ≈ 1.0 적용 가능"
    },

    "group_settlement": {
      "equivalent_raft_method": {
        "formula": "Sg = S * sqrt(Bg / D)",
        "variables": {
          "Sg": {
            "name": "무리말뚝 침하량",
            "unit": "mm"
          },
          "S": {
            "name": "단일말뚝 침하량",
            "unit": "mm"
          },
          "Bg": {
            "name": "무리말뚝 폭",
            "unit": "m"
          }
        }
      }
    }
  },

