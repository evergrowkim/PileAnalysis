    }
  },

  "calculation_workflow": {
    "description": "계산 순서 및 알고리즘 흐름",

    "step1_input_data": {
      "order": 1,
      "name": "입력 데이터 수집",
      "required_inputs": [
        "pile_type (타입/매입/현장타설)",
        "pile_diameter (D)",
        "pile_length (L)",
        "pile_material (강관/PHC/콘크리트)",
        "soil_profile (층별 토질정보)",
        "N_values (층별 N값)",
        "groundwater_level",
        "design_load"
      ]
    },

    "step2_soil_parameter": {
      "order": 2,
      "name": "지반정수 산정",
      "tasks": [
        "층별 토질 분류 (사질토/점성토/암반)",
        "선단 N값 산정 (상1D~하4D 평균)",
        "주면 N값 산정 (층별 가중평균)",
        "cu 산정 (점성토인 경우)",
        "E0 산정 (수평지지력용)"
      ]
    },

    "step3_vertical_capacity": {
      "order": 3,
      "name": "연직 허용지지력 산정",
      "sub_steps": [
        "qp 산정 (공법/지반별 공식 적용)",
        "fs 산정 (층별 적용 후 합산)",
        "Rp = qp × Ap 계산",
        "Rf = Σ(fs × As) 계산",
        "We 계산 (부력 고려)",
        "Ra = (Rp + Rf) / Fs - We"
      ]
    },

    "step4_horizontal_capacity": {
      "order": 4,
      "name": "수평 허용지지력 산정",
      "sub_steps": [
        "E0 산정 (지반조건에 따라 700N or 2800N)",
        "kh 산정 (반복계산)",
        "β 산정",
        "Chang's Method: Ha_chang = kh×D×ya/β",
        "Broms' Method: Hu_broms 산정 후 안전율 적용",
        "Ha = min(Ha_chang, Hu_broms/Fs)"
      ]
    },

    "step5_pullout_capacity": {
      "order": 5,
      "name": "인발 허용지지력 산정",
      "sub_steps": [
        "인발 fs 산정 (압축의 80% 저감)",
        "Qu = Σ(fs_pullout × As)",
        "Wp 산정 (유효자중)",
        "Qpull = Qu/Fs + Wp"
      ]
    },

    "step6_settlement": {
      "order": 6,
      "name": "침하량 산정",
      "sub_steps": [
        "하중 분담율 가정 (선단/주면)",
        "Ss 산정 (탄성압축)",
        "Cp 선정 (지반/공법별)",
        "Sp 산정 (선단침하)",
        "Cs 산정",
        "Sps 산정 (주면침하)",
        "Stotal = Ss + Sp + Sps",
        "허용침하량 비교 검토"
      ]
    },

    "step7_group_effect": {
      "order": 7,
      "name": "무리말뚝 효과 검토",
      "condition": "말뚝 간격 < 8D인 경우",
      "sub_steps": [
        "효율 η 산정 (Converse-Labarre)",
        "Qa_group = n × Qa × η",
        "무리말뚝 침하량 산정"
      ]
    },

    "step8_verification": {
      "order": 8,
      "name": "검증 및 결과 출력",
      "checks": [
        "Ra ≥ 설계하중 (연직)",
        "Ha ≥ 설계수평하중",
        "Qpull ≥ 설계인발하중",
        "Stotal ≤ 허용침하량",
        "말뚝 본체 응력 검토"
      ]
    }
  },

  "validation_rules": {
    "description": "계산 결과 검증 규칙",
    "vertical": {
